#!/usr/bin/env bash
# iscooter-progress-hook
exec >/dev/null 2>&1

TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"

if [ -n "$TOPLEVEL" ] && [ -n "$COMMON_DIR" ]; then
    MAIN_DIR="$(cd "$COMMON_DIR/.." 2>/dev/null && pwd -P)"
    CURRENT_DIR="$(cd "$TOPLEVEL" 2>/dev/null && pwd -P)"
    if [ "$CURRENT_DIR" = "$MAIN_DIR" ]; then
        timeout 3 python3 "$TOPLEVEL/scripts/progress/progress.py" --root "$TOPLEVEL" build || true
    fi
fi

exit 0
